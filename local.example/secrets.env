# Copy to local/secrets.env (git-ignored, chmod 600). Leave unused lines empty.
# Loaded by scripts that need keys; never paste these values into a chat.

# App Store Connect API (ASC uploads, listing pushes)
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_KEY_PATH=            # path to AuthKey_XXXX.p8

# Apple Search Ads API
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=
APPLE_ADS_KEY_PATH=      # path to the EC private key .pem

# Analytics and revenue (only if you call the APIs directly; MCP connectors need none of these)
POSTHOG_PERSONAL_API_KEY=
REVENUECAT_API_KEY=

# Google Play (AAB uploads)
PLAY_SERVICE_ACCOUNT_JSON=   # path to the service-account json

# Optional
FIGMA_TOKEN=
VERCEL_TOKEN=
